// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ========== 枚举定义 ==========

enum Gender {
  boy
  girl
}

enum Intent {
  daily
  emergency
  nourishment
  venting
}

enum Source {
  manual
  extracted
  accompany
  venting
}

enum EventType {
  strength
  challenge
  milestone
  interaction
  growth
}

enum ModifiedBy {
  ai
  parent
}

enum ProfileEventSource {
  manual
  accompany
  venting
}

// ========== 用户与认证 ==========

model User {
  id         String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  phone      String?   @unique @db.VarChar(20)
  nickname   String    @default("用户") @db.VarChar(50)
  avatarUrl  String?   @map("avatar_url") @db.VarChar(255)
  password   String?   @db.VarChar(255)
  parentRole String?   @map("parent_role") @db.VarChar(20)
  lastLoginAt DateTime? @map("last_login_at") @db.Timestamp
  lastLoginIp String?   @map("last_login_ip") @db.VarChar(50)
  expireAt   DateTime?  @map("expire_at") @db.Timestamp  // 到期时间，null表示无限制
  status     String    @default("active") @map("status") @db.VarChar(20)  // pending=待激活, active=已激活
  source     String    @default("organic") @map("source") @db.VarChar(20)  // nzyy=从nzyy跳转, organic=直接访问
  points     Int       @default(0) @map("points")  // 积分余额
  createdAt  DateTime  @default(now()) @map("created_at") @db.Timestamp
  updatedAt  DateTime  @updatedAt @map("updated_at") @db.Timestamp
  portalUserId String?  @map("portal_user_id") @db.VarChar(64) @unique

  children     Child[]
  apply       Apply?
  activities   UserActivity[]
  pointTx     PointTransaction[]

  @@map("users")
}

model AuthSession {
  id        String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  phone     String   @db.VarChar(20)
  code      String   @db.VarChar(10)
  expiresAt DateTime @map("expires_at") @db.Timestamp
  used      Boolean  @default(false)
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamp

  @@index([phone])
  @@map("auth_sessions")
}

// ========== 孩子档案 ==========

model Child {
  id        String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId    String   @map("user_id") @db.Uuid
  name      String   @db.VarChar(100)
  birthDate DateTime @map("birth_date") @db.Date
  gender    String?  @db.VarChar(10)
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamp
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamp

  user               User                 @relation(fields: [userId], references: [id], onDelete: Cascade)
  records            Record[]
  questions          Question[]
  nourishmentMoments NourishmentMoment[]
  nourishmentReports NourishmentReport[]
  childProfile       ChildProfile?
  profileEvents      ProfileEvent[]
  profileVersions    ProfileVersion[]
  dailyCareRecords   DailyCareRecord[]
  profileOpportunities ProfileOpportunity[]

  @@index([userId])
  @@map("children")
}

// ========== 陪伴记录 ==========

model Record {
  id        String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  childId   String   @map("child_id") @db.Uuid
  content   String   @db.Text
  reply     String?  @db.Text
  intent    Intent   @default(daily)
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamp

  child               Child                 @relation(fields: [childId], references: [id], onDelete: Cascade)
  extractedFromRecord NourishmentMoment[]   @relation("extracted_from_record")

  @@index([childId])
  @@index([createdAt(sort: Desc)])
  @@map("records")
}

// ========== 问答记录 ==========

model Question {
  id        String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  childId   String   @map("child_id") @db.Uuid
  content   String   @db.Text
  answer    String?  @db.Text
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamp

  child Child @relation(fields: [childId], references: [id], onDelete: Cascade)

  @@index([childId])
  @@map("questions")
}

// ========== 滋养时刻 ==========

model NourishmentMoment {
  id                     String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  childId                String   @map("child_id") @db.Uuid
  fact                   String   @db.Text
  feeling                String?  @db.Text
  level                  String?  @map("level") @db.VarChar(20)  // 滋养层次：彼此连接、彼此看见和懂得、彼此理解、彼此支持
  source                 Source   @default(manual)
  extractedFromRecordId  String?  @map("extracted_from_record_id") @db.Uuid
  createdAt              DateTime @default(now()) @map("created_at") @db.Timestamp

  child         Child   @relation(fields: [childId], references: [id], onDelete: Cascade)
  extractedFrom Record? @relation("extracted_from_record", fields: [extractedFromRecordId], references: [id], onDelete: SetNull)

  @@index([childId])
  @@index([createdAt(sort: Desc)])
  @@map("nourishment_moments")
}

// ========== 滋养报告 ==========

model NourishmentReport {
  id          String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  childId     String   @map("child_id") @db.Uuid
  periodType  String   @map("period_type") @db.VarChar(20)
  periodStart DateTime @map("period_start") @db.Date
  periodEnd   DateTime @map("period_end") @db.Date
  content     Json?
  momentCount Int      @default(0) @map("moment_count")
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamp

  child Child @relation(fields: [childId], references: [id], onDelete: Cascade)

  @@unique([childId, periodType])
  @@index([childId])
  @@index([periodType])
  @@map("nourishment_reports")
}

// ========== 孩子画像 ==========

model ChildProfile {
  id           String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  childId      String   @unique @map("child_id") @db.Uuid
  personality  Json?
  interests    Json?
  strengths    Json?
  challenges   Json?
  coreNeeds    Json?    @map("core_needs")
  growthGoals  Json?    @map("growth_goals")
  aiAnalysis   Json?    @map("ai_analysis")
  parentWeight Float    @default(0.5) @map("parent_weight")
  updatedAt    DateTime @updatedAt @map("updated_at") @db.Timestamp

  child Child @relation(fields: [childId], references: [id], onDelete: Cascade)

  @@index([childId])
  @@map("child_profiles")
}

// ========== 画像事件库 ==========

model ProfileEvent {
  id            String              @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  childId       String              @map("child_id") @db.Uuid
  eventType     EventType?          @map("event_type")
  fact          String              @db.Text
  interpretation String?            @db.Text
  source        ProfileEventSource?
  createdAt     DateTime            @default(now()) @map("created_at") @db.Timestamp

  child Child @relation(fields: [childId], references: [id], onDelete: Cascade)

  @@index([childId])
  @@index([eventType])
  @@map("profile_events")
}

// ========== 画像版本历史 ==========

model ProfileVersion {
  id               String     @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  childId          String     @map("child_id") @db.Uuid
  version          Int
  snapshot         Json
  modifiedBy       ModifiedBy? @map("modified_by")
  modifications    Json?
  aiAnalysisAtTime Json?      @map("ai_analysis_at_time")
  reviewFlags      Json?      @map("review_flags")
  createdAt        DateTime   @default(now()) @map("created_at") @db.Timestamp

  child Child @relation(fields: [childId], references: [id], onDelete: Cascade)

  @@index([childId])
  @@map("profile_versions")
}

// ========== 每日陪伴记录（AI 分析结果） ==========

model DailyCareRecord {
  id               String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  childId          String    @map("child_id") @db.Uuid
  content          String    @db.Text
  reply            String?   @db.Text
  strengths        Json?
  opportunityAxis1 Json?     @map("opportunity_axis1")
  opportunityAxis2 Json?     @map("opportunity_axis2")
  advice           String?   @db.Text
  growthSummary    String?   @map("growth_summary") @db.Text
  intent           Intent    @default(daily)
  touchPoint       String?   @map("touch_point") @db.VarChar(50)
  thinkingShift    String?   @map("thinking_shift") @db.VarChar(50)
  plannedAction    String?   @map("planned_action") @db.Text
  createdAt        DateTime  @default(now()) @map("created_at") @db.Timestamp

  child Child @relation(fields: [childId], references: [id], onDelete: Cascade)

  @@index([childId])
  @@map("daily_care_record")
}

// ========== 机会窗口 ==========

model ProfileOpportunity {
  id               String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  childId         String    @map("child_id") @db.Uuid
  dimension        String?   @db.VarChar(50)
  element          String?   @db.VarChar(50)
  description      String    @db.Text
  suggestion       String?   @db.Text
  status           String    @default("open") @db.VarChar(20)
  firstAppearedAt  DateTime? @map("first_appeared_at") @db.Timestamp
  lastAppearedAt   DateTime? @map("last_appeared_at") @db.Timestamp
  appearanceCount  Int       @default(1) @map("appearance_count")
  warningLevel     Int       @default(0) @map("warning_level")
  sourceRecordId   String?   @map("source_record_id") @db.Uuid
  createdAt        DateTime  @default(now()) @map("created_at") @db.Timestamp
  updatedAt        DateTime  @updatedAt @map("updated_at") @db.Timestamp

  child Child @relation(fields: [childId], references: [id], onDelete: Cascade)

  @@index([childId])
  @@index([status])
  @@index([warningLevel])
  @@map("profile_opportunities")
}

// ========== 家长反思 ==========

model ParentReflection {
  id                    String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId               String    @map("user_id") @db.Uuid
  childId              String?   @map("child_id") @db.Uuid
  content              String    @db.Text
  relatedRecordId      String?   @map("related_record_id") @db.Uuid
  relatedOpportunityId String?   @map("related_opportunity_id") @db.Uuid
  createdAt           DateTime  @default(now()) @map("created_at") @db.Timestamp

  @@index([userId])
  @@map("parent_reflections")
}

// ========== 用户行为记录 ==========

model UserActivity {
  id        String   @id @default(cuid())
  userId    String   @map("user_id") @db.Uuid
  type      String   @db.VarChar(20)  // "share" | "invite" | "feedback"
  month     String   @db.VarChar(7)    // "2026-09" 格式
  count     Int      @default(1)
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamp

  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, type, month])
  @@index([userId])
  @@index([month])
  @@map("user_activities")
}

// ========== 邀请申请 ==========

model Apply {
  id          String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  phone       String    @unique @db.VarChar(20)
  shareCode   String    @unique @map("share_code") @db.VarChar(8)
  status      String    @default("pending") @db.VarChar(20) // pending/invite_ready/activated
  referrerId  String?   @map("referrer_id") @db.Uuid
  inviteCode  String?   @unique @map("invite_code") @db.VarChar(8)
  inviteUsedAt DateTime? @map("invite_used_at") @db.Timestamp
  inviteExpiresAt DateTime? @map("invite_expires_at") @db.Timestamp
  userId      String?   @unique @map("user_id") @db.Uuid  // 关联正式用户
  activatedAt DateTime? @map("activated_at") @db.Timestamp
  createdAt   DateTime  @default(now()) @map("created_at") @db.Timestamp

  user        User?     @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([referrerId])
  @@index([userId])
  @@map("applies")
}

model ShareLog {
  id        String    @id @default(cuid())
  applyId   String    @map("apply_id") @db.Uuid
  visitorIp String?   @map("visitor_ip") @db.VarChar(50)
  applied   Boolean   @default(false)
  appliedAt DateTime? @map("applied_at") @db.Timestamp
  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamp

  @@index([applyId])
  @@map("share_logs")
}

// 激励发放记录
model ApplyReward {
  id         String   @id @default(cuid())
  applyId    String   @map("apply_id") @db.Uuid
  period     String   @db.VarChar(10)  // "week" | "month"
  type       String   @db.VarChar(10)  // "opens" | "users"
  rank       Int
  rewardCode String?  @map("reward_code") @db.VarChar(8)
  medal      Boolean  @default(false)  // 是否发放电子勋章
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamp

  @@unique([applyId, period, type])
  @@index([applyId])
  @@map("apply_rewards")
}

// ========== 积分系统 ==========

// 积分流水
model PointTransaction {
  id          String   @id @default(cuid())
  userId      String   @map("user_id") @db.Uuid
  type        String   @db.VarChar(30)  // earn_record/earn_nourishment/earn_vent/earn_reflection/earn_report/earn_share/earn_invite/earn_profile/earn_child/redeem/expire
  amount      Int      // 正=获得, 负=消耗
  balance     Int      // 变动后余额
  description String?  @db.VarChar(200)
  relatedId   String?  // 关联记录ID
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamp

  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([createdAt])
  @@map("point_transactions")
}
