# Copy this file to `.env` and replace the placeholder with your real connection string.
# Connection string for PostgreSQL.
# Requires PostgreSQL >= 15.

DATABASE_URL="postgresql://user:password@localhost:5432/mydb"

# Upstash Redis（用于接口限流）
# https://console.upstash.com/ 创建免费 Redis 数据库
UPSTASH_REDIS_REST_URL=https://your-redis-url.upstash.io
UPSTASH_REDIS_REST_TOKEN=your-token

# Cron 任务密钥（用于触发激励发放等定时任务）
CRON_SECRET=your-cron-secret-key

# nzyy 门户 API（用于验证跳转 token）
NZYY_API_URL=https://nzyy.cc/api

# 管理员联系方式（领取激活码的入口，客户端组件读）
NEXT_PUBLIC_ADMIN_CONTACT_EMAIL=support@nzyy.cc
NEXT_PUBLIC_ADMIN_WECOM_IMAGE=/images/wecom.png

# MiniMax 语音服务（设备接入：ASR 语音识别 / TTS 语音合成）
# 只在服务端使用，绝不能下发到硬件
MINIMAX_API_KEY=
MINIMAX_BASE_URL=https://api.minimaxi.com
